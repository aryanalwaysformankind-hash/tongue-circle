import { useState } from "react";
import type { ReactNode } from "react";
import { Link, NavLink, useLocation } from "react-router-dom";
import { useAuth, useClerk, useUser } from "@clerk/react";
import { useQuery } from "@tanstack/react-query";
import { BookmarkCheck, Compass, Globe2, LogOut, MessageCircle, UserRound } from "lucide-react";
import { apiGet } from "@/lib/api";
import { endSession } from "@/lib/session";
import type { UnreadCount } from "@/lib/types";

interface AppShellProps {
  children: ReactNode;
}

const navItems = [
  { label: "Discover", path: "/", icon: Compass },
  { label: "Messages", path: "/messages", icon: MessageCircle },
  { label: "Phrases", path: "/phrases", icon: BookmarkCheck },
  { label: "My profile", path: "/profile", icon: UserRound },
];

export default function AppShell({ children }: AppShellProps) {
  const { user } = useUser();
  const { signOut } = useClerk();
  const { getToken } = useAuth();
  const location = useLocation();
  const [signingOut, setSigningOut] = useState(false);
  const unreadQuery = useQuery({
    queryKey: ["unread"],
    queryFn: async () => apiGet<UnreadCount>("/messages/unread-count", await getToken()),
    refetchInterval: 15_000,
  });
  const unread = unreadQuery.isError ? 0 : unreadQuery.data?.count ?? 0;

  const handleSignOut = async () => {
    setSigningOut(true);
    try {
      await signOut();
      await endSession("/");
    } finally {
      setSigningOut(false);
    }
  };

  return (
    <div className="min-h-svh bg-[#FAF8F5] text-[#1E1F24]">
      <header className="sticky top-0 z-30 border-b border-black/5 bg-white/85 backdrop-blur-xl">
        <div className="mx-auto flex max-w-7xl items-center justify-between gap-4 px-4 py-3 sm:px-6 lg:px-8">
          <Link to="/" className="flex shrink-0 items-center gap-2.5" data-testid="brand-home-link">
            <span className="flex size-9 items-center justify-center rounded-xl bg-[#D9532F] text-white">
              <Globe2 className="size-5" aria-hidden="true" />
            </span>
            <span className="font-heading text-lg font-bold tracking-tight">Tongue Circle</span>
          </Link>
          <nav aria-label="Main navigation" className="flex items-center gap-1 sm:gap-2">
            {navItems.map(({ label, path, icon: Icon }) => (
              <NavLink
                key={path}
                to={path}
                end={path === "/"}
                data-testid={`nav-${label.toLowerCase().replaceAll(" ", "-")}-link`}
                className={({ isActive }) =>
                  `flex items-center gap-2 rounded-full px-3 py-2 text-sm font-semibold transition-colors ${
                    isActive || (path === "/messages" && location.pathname.startsWith(path))
                      ? "bg-[#F4EBE2] text-[#B84728]"
                      : "text-stone-600 hover:bg-stone-100 hover:text-stone-900"
                  }`
                }
              >
                <span className="relative">
                  <Icon className="size-4" aria-hidden="true" />
                  {path === "/messages" && unread > 0 && (
                    <span
                      data-testid="nav-messages-unread-badge"
                      aria-label={`${unread} unread messages`}
                      className="animate-rise absolute -right-2.5 -top-2 flex h-4 min-w-4 items-center justify-center rounded-full bg-[#D9532F] px-1 text-[10px] font-bold leading-none text-white ring-2 ring-white"
                    >
                      {unread > 9 ? "9+" : unread}
                    </span>
                  )}
                </span>
                <span className="hidden sm:inline" data-testid={`nav-${label.toLowerCase().replaceAll(" ", "-")}-label`}>{label}</span>
              </NavLink>
            ))}
          </nav>
          <div className="flex items-center gap-2">
            {user?.imageUrl && (
              <img
                src={user.imageUrl}
                alt="Your Google profile"
                className="size-9 rounded-full object-cover ring-2 ring-white"
                data-testid="signed-in-user-photo"
              />
            )}
            <button
              type="button"
              onClick={() => void handleSignOut()}
              disabled={signingOut}
              data-testid="sign-out-button"
              className="inline-flex items-center gap-2 rounded-full px-3 py-2 text-sm font-semibold text-stone-600 transition-colors hover:bg-stone-100 hover:text-[#B84728] disabled:opacity-60"
            >
              <LogOut className="size-4" aria-hidden="true" />
              <span className="hidden md:inline">{signingOut ? "Signing out…" : "Sign out"}</span>
            </button>
          </div>
        </div>
      </header>
      <main className="mx-auto max-w-7xl px-4 py-7 sm:px-6 sm:py-9 lg:px-8">
        {children}
      </main>
      <footer className="mx-auto flex max-w-7xl items-center justify-between gap-4 px-4 pb-8 text-xs text-stone-500 sm:px-6 lg:px-8">
        <span data-testid="footer-tagline">A little more understood, every day.</span>
        <span data-testid="footer-community-name">Tongue Circle · Language exchange</span>
      </footer>
    </div>
  );
}
